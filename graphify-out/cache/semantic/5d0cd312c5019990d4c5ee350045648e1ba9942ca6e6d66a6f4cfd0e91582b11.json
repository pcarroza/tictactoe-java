{"nodes": [{"id": "agents_steering_04_design_patterns_doc", "label": "Design Patterns Catalog - Quick Reference", "file_type": "document", "source_file": ".agents/steering/04-design-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_steering_04_design_patterns_state_pattern", "label": "State pattern", "file_type": "rationale", "rationale": "An object changes its behavior based on internal state; avoids if/switch by state.", "source_file": ".agents/steering/04-design-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_steering_04_design_patterns_command_pattern", "label": "Command pattern", "file_type": "rationale", "rationale": "Encapsulate an action as an object (undo, menu, operation queue).", "source_file": ".agents/steering/04-design-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_steering_04_design_patterns_observer_pattern", "label": "Observer pattern", "file_type": "rationale", "rationale": "An object notifies others without knowing them; decoupled subject + subscribers.", "source_file": ".agents/steering/04-design-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_steering_04_design_patterns_strategy_pattern", "label": "Strategy pattern", "file_type": "rationale", "rationale": "The algorithm varies but the structure is fixed; inject the concrete strategy.", "source_file": ".agents/steering/04-design-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_steering_04_design_patterns_template_method_pattern", "label": "Template Method pattern", "file_type": "rationale", "rationale": "The algorithm skeleton is fixed; some steps vary in subclasses.", "source_file