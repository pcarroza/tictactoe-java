{"nodes": [{"id": "agents_steering_01_oo_principles_doc", "label": "OO Principles - Quick Reference", "file_type": "document", "source_file": ".agents/steering/01-oo-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_steering_01_oo_principles_expert", "label": "GRASP: Information Expert", "file_type": "rationale", "rationale": "Assign the responsibility to the class that has the information necessary to fulfill it.", "source_file": ".agents/steering/01-oo-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_steering_01_oo_principles_high_cohesion", "label": "GRASP: High Cohesion", "file_type": "rationale", "rationale": "A class does closely related things; split it if it does too much or disparate things.", "source_file": ".agents/steering/01-oo-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_steering_01_oo_principles_low_coupling", "label": "GRASP: Low Coupling", "file_type": "rationale", "rationale": "Minimize dependencies between classes; prefer depending on abstractions, not concretes.", "source_file": ".agents/steering/01-oo-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_steering_01_oo_principles_controller", "label": "GRASP: Controller", "file_type": "rationale", "rationale": "System events are received by a Controller class, never the UI; the UI delegates.", "source_file": ".agents/steering/01-oo-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_steering_01_oo_principles_creator", "label": "GRASP: Creator", "file_type": "rationale", "rationale": "B creates A if B contains, aggregates, records, or uses A, or has A's initialization data.", "source_file": ".agents/steering/01-oo-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_steering_01_oo_principles_pure_fabrication", "label": "GRASP: Pure Fabrication", "file_type": "rationale", "rationale": "If assigning a responsibility violates cohesion or coupling, create an artificial class to encapsulate it.", "source_file": ".agents/steering/01-oo-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_steering_01_oo_principles_indirection", "label": "GRASP: Indirection", "file_type": "rationale", "rationale": "To decouple two classes, introduce an intermediary between them.", "source_file": ".agents/steering/01-oo-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_steering_01_oo_principles_polymorphism", "label": "GRASP: Polymorphism", "file_type": "rationale", "rationale": "When behavior varies by type, use polymorphic operations. Never instanceof or switch by type.", "source_file": ".agents/steering/01-oo-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_steering_01_oo_principles_protected_variations", "label": "GRASP: Protected Variations", "file_type": "rationale", "rationale": "Identify points of variation or instability and build a stable interface around them.", "source_file": ".agents/steering/01-oo-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_steering_01_oo_principles_srp", "label": "SOLID: Single Responsibility Principle", "file_type": "rationale", "rationale": "A class has a single reason to change; if it changes for two distinct reasons, split it.", "source_file": ".agents/steering/01-oo-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_steering_01_oo_principles_ocp", "label": "SOLID: Open/Closed Principle", "file_type": "rationale", "rationale": "Open to extension (new derived classes), closed to modification (do not touch working code).", "source_file": ".agents/steering/01-oo-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_steering_01_oo_principles_lsp", "label": "SOLID: Liskov Substitution Principle", "file_type": "rationale", "rationale": "A subclass must be substitutable for its base class without breaking the program.", "source_file": ".agents/steering/01-oo-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_steering_01_oo_principles_isp", "label": "SOLID: Interface Segregation Principle", "file_type": "rationale", "rationale": "Clients should not depend on interfaces they do not use; prefer several cohesive interfaces to one fat one.", "source_file": ".agents/steering/01-oo-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_steering_01_oo_principles_dip", "label": "SOLID: Dependency Inversion Principle", "file_type": "rationale", "rationale": "High-level modules do not depend on low-level modules; both depend on abstractions.", "source_file": ".agents/steering/01-oo-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_steering_01_oo_principles_yagni", "label": "YAGNI", "file_type": "rationale", "rationale": "Do not apply a principle speculatively when there is no real point of variation.", "source_file": ".agents/steering/01-oo-principles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agen