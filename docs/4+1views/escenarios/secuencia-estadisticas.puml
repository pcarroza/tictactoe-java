@startuml secuencia-estadisticas
actor Jugador
participant StatisticsModule
participant LocalStatisticsController
participant ConsoleStatisticsView
participant Statistics
participant ProfileRegistry

Jugador -> StatisticsModule : selecciona "Estadísticas"
StatisticsModule -> LocalStatisticsController : new(statistics, profileRegistry)
StatisticsModule -> ConsoleStatisticsView : interact(controller)
ConsoleStatisticsView -> LocalStatisticsController : getTotalGames()
LocalStatisticsController -> Statistics : getTotalGames()
ConsoleStatisticsView -> LocalStatisticsController : getWins(XS) / getWins(OS)
LocalStatisticsController -> Statistics : getWins(player)
ConsoleStatisticsView -> LocalStatisticsController : getName(XS) / getName(OS)
LocalStatisticsController -> ProfileRegistry : findByToken(player)
ConsoleStatisticsView -> Jugador : muestra estadísticas

@enduml
