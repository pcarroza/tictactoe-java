@startuml secuencia-persistencia
actor Jugador
participant LoadModule
participant LocalLoadController
participant ConsoleLoadView
participant GameModule

Jugador -> LoadModule : selecciona "Cargar partida"
LoadModule -> LocalLoadController : new(gameRegistry)
LoadModule -> ConsoleLoadView : interact(controller)
ConsoleLoadView -> LocalLoadController : accept(this)
LocalLoadController -> ConsoleLoadView : visit(controller)
ConsoleLoadView -> LocalLoadController : hasGames()
ConsoleLoadView -> LocalLoadController : getGameTitles()
ConsoleLoadView -> Jugador : muestra lista
Jugador -> ConsoleLoadView : elige partida
ConsoleLoadView -> LocalLoadController : select(indice)
LoadModule -> LocalLoadController : getSelected()
LocalLoadController --> LoadModule : GameSnapshot
LoadModule -> GameModule : new GameModule(snapshot, gameRegistry, consoleContext).run()
note right of GameModule
  Continúa igual que secuencia-partida.puml,
  pero LocalGameLogic arranca en InGameState.
  gameRegistry y consoleContext son los mismos
  que LoadModule recibió por constructor —
  nunca se leen vía getInstance()
end note
@enduml
